# Copia este archivo como .env y completa los valores (no lo subas al repositorio).
DOMINIO=www.incerpaz.com
DOMINIO_RAIZ=incerpaz.com

# Administrador inicial (se crea una sola vez en el primer arranque)
ADMIN_CORREO=hugop1006@gmail.com
ADMIN_NOMBRE=Hugo
ADMIN_PASSWORD=cambia-esta-clave-larga

# Sitio público e indexable: 0 mientras pruebas, 1 el día de la salida
PUBLICO=0
CANONICAL_HOST=www.incerpaz.com

# Detrás de Caddy
COOKIE_SECURE=1
TRUST_PROXY=1

# Respaldos diarios en /datos/respaldos (se conservan los últimos 14)
RESPALDO_DIARIO=1
RESPALDOS_MAX=14

# Solo si pones Cloudflare delante (ver server/DESPLIEGUE.md)
CLOUDFLARE=1
# ORIGEN_SECRETO=valor-largo-igual-al-de-la-regla-de-Cloudflare
# CSP_SCRIPT_EXTRA=https://static.cloudflareinsights.com
# CSP_CONNECT_EXTRA=https://cloudflareinsights.com
